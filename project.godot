; Engine configuration file. Edit via GitHub web editor or Godot editor.
config_version=5

[application]
config/name="Mini Commandoes"
config/description="Original 2D multiplayer commando action game."
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]
Version="*res://src/core/version.gd"
DataRegistry="*res://src/autoload/data_registry.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
